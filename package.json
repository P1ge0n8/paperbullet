    "modern-screenshot": "4.7.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
