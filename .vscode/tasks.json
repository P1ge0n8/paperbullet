{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "锵稿：启动本地后台",
      "type": "npm",
      "script": "admin",
      "isBackground": true,
      "problemMatcher": {
        "owner": "paperbullet-admin",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> paperbullet.* admin$",
          "endsPattern": "本地后台：http://127\\.0\\.0\\.1:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "锵稿：只预览前台",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "paperbullet-preview",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> paperbullet.* dev$",
          "endsPattern": "Local:.*http://"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "锵稿：发布前检查",
      "type": "npm",
      "script": "check",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "锵稿：手动发布到 GitHub",
      "type": "npm",
      "script": "publish:github",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
